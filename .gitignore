# Generated by Cargo
# will have compiled files and executables
debug/
target/

# `Cargo.lock` is committed: this is a binary crate, and the desktop build
# depends on an unpinned upstream git dependency (`tauri-sys`), so the lock
# file is what makes builds reproducible.
# See https://doc.rust-lang.org/cargo/guide/cargo-toml-vs-cargo-lock.html

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

dist/

.DS_Store
.codebuddy
